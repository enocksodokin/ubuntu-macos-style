[blur-my-shell]
rounded-blur-found=false
settings-version=2


[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30


[blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
sigma=30
static-blur=true
style-dash-to-dock=0


[blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
sigma=30


[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30


[com/github/hermes83/compiz-windows-effect]
last-version=31
preset='R'


[dash-to-dock]
autohide=true
background-opacity=0.25
click-action='minimize-or-previews'
custom-theme-shrink=true
dash-max-icon-size=48
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
icon-size-fixed=false
intellihide=true
running-indicator-style='DOTS'
show-favorites=true
show-mounts=false
show-running=true
show-trash=false
transparency-mode='FIXED'


[desktop-widgets-r3nhick]
drag-active=false
layout-json='{"version":3,"widgets":[]}'


[lintel]
control-center-controls=['wifi', 'network', 'media', 'bluetooth', 'airdrop', 'stage-manager', 'screen-mirroring', 'dark-mode', 'screenshot', 'focus', 'display', 'sound', 'night-light', 'airplane', 'microphone', 'power-mode']


[tiling-assistant]
focus-hint-color='rgb(211,70,21)'
last-version-installed=54
overridden-settings={'org.gnome.mutter.edge-tiling': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-left': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-right': <@mb nothing>}
tiling-popup-all-workspace=true


[user-theme]
name=''
